# The Python app reads the repo-root .env first (shared with the TypeScript app).
# Copy this file to python/.env only if you need Python-specific overrides.

OPENAI_API_KEY=sk-...
# Defaults to gpt-4.1-mini on the Python side. Set it to any chat model your key can call.
OPENAI_MODEL=gpt-4.1-mini

# Not read by the base app (py-01). Used from py-02-tracing onward.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=dad-it-support-agent
LANGFUSE_PROMPT_LABEL=production

DATASET_NAME=dad-it-support-workshop
