# Set one model credential. LANGFUSE_GATEWAY_KEY is used when it is set,
# ahead of OPENAI_API_KEY and ANTHROPIC_API_KEY.
# LANGFUSE_GATEWAY_KEY=
# EU: https://gateway.cloud.langfuse.com
# US: https://gateway.us.cloud.langfuse.com
# LANGFUSE_GATEWAY_HOST=https://gateway.cloud.langfuse.com

# When the gateway key is empty, OpenAI is the default when OPENAI_API_KEY is
# set, and those calls go to https://api.openai.com/v1.
# To use Claude instead, leave OPENAI_API_KEY empty and set ANTHROPIC_API_KEY,
# or set LLM_PROVIDER=anthropic when both keys are present. Claude is called
# through Anthropic's OpenAI-compatible endpoint, so the app still uses the
# OpenAI SDK and observeOpenAI.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5-2026-04-23

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Personal or service-account keys that are not scoped to a workspace also need:
# ANTHROPIC_WORKSPACE_ID=
# LLM_PROVIDER=openai

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=dad-it-support-agent
LANGFUSE_PROMPT_LABEL=production

DATASET_NAME=dad-it-support-workshop
