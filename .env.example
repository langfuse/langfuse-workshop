# Model calls. Set LANGFUSE_GATEWAY_KEY to send them through the Langfuse AI
# Gateway, or leave it empty and set OPENAI_API_KEY to call OpenAI directly.
# The gateway key wins when both are set.
# LANGFUSE_GATEWAY_KEY=
# EU: https://gateway.cloud.langfuse.com
# US: https://gateway.us.cloud.langfuse.com
# LANGFUSE_GATEWAY_HOST=https://gateway.cloud.langfuse.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5-2026-04-23

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=dad-it-support-agent
LANGFUSE_PROMPT_LABEL=production

DATASET_NAME=dad-it-support-workshop
